{
  "name": "ai-gateway-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.14 <23",
    "npm": ">=10.9 <11"
  },
  "scripts": {
    "dev": "vite",
    "check:types": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
